<View>
  <Header value="$project"/>
  <Text name="sub" value="$sub"/>
  <Header value="$type · $folder"/>
  <Text name="rec" value="$rec"/>
  <Text name="title" value="$title"/>
  <Text name="hint" value="$hint"/>
  <Text name="meta" value="$meta"/>
  <Header value="当前意见：$tag"/>
  <Text name="text" value="$text"/>

  <Header value="评审标签"/>
  <Choices name="tag" toName="title" choice="single" showInline="true">
    <Choice value="先做"/>
    <Choice value="缓做"/>
    <Choice value="不做"/>
    <Choice value="有异议"/>
  </Choices>

  <Header value="理由"/>
  <TextArea name="note" toName="title" rows="4" maxSubmissions="1"/>
</View>
